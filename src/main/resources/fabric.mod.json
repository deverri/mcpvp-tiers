{
  "schemaVersion": 1,
  "id": "mcpvp-tiers",
  "version": "${version}",
  "name": "MCPvP Tiers (Tiers Fork)",
  "description": "Shows MCPvP (mcpvp.com) tiers on nametags, the tab list and chat, alongside PvPTiers, MCTiers and Subtiers. Unofficial fork of the Tiers mod by Flavio6561; not affiliated with MCPvP or PvPTiers.",
  "authors": [
    "${fork_author}",
    {
      "name": "Flavio6561 (original Tiers author)",
      "contact": {
        "homepage": "https://github.com/PvPTiers/Tiers"
      }
    }
  ],
  "license": "GPL-3.0-only",
  "contact": {
    "homepage": "${homepage_url}",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "${sources_url}",
        "Original Tiers mod": "https://github.com/PvPTiers/Tiers"
      }
    }
  },
  "icon": "assets/mcpvp-tiers/icon.png",
  "entrypoints": {
    "client": [
      "com.tiers.TiersClient"
    ],
    "modmenu": [
      "com.tiers.misc.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "tiers.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": [
      "${minecraft_version}"
    ],
    "java": ">=25",
    "fabric-api": "*"
  },
  "breaks": {
    "tiers": "*"
  }
}
